---
import Doodle from "./Doodle.astro";

const activities = [
  { kind: "climbing", label: "climbing", doodle: "climbing-holds" },
  { kind: "running", label: "running", doodle: "running" },
  { kind: "basketball", label: "basketball", doodle: "basketball" },
] as const;
---

<activity-toy-box class="activity-toybox" aria-labelledby="activity-toybox-label">
  <h2 class="activity-toybox-heading" id="activity-toybox-label">touching grass</h2>
  <p class="activity-toybox-hint" aria-hidden="true">
    <span class="activity-toybox-hint-fine">hover to identify · drag to throw</span>
    <span class="activity-toybox-hint-touch">drag to explore</span>
    <span class="activity-toybox-hint-reduced">activities at rest</span>
  </p>
  <div class="activity-toybox-frame">
    <div class="activity-toybox-world" data-toybox-world>
      {
        activities.map((activity) => (
          <span class="activity-toybox-body" data-kind={activity.kind} role="img" aria-label={activity.label}>
            <span class="activity-toybox-label">{activity.label}</span>
            <span class="activity-toybox-glyph" data-toybox-glyph>
              <Doodle name={activity.doodle} class="activity-toybox-doodle" />
            </span>
          </span>
        ))
      }
    </div>
  </div>
</activity-toy-box>

<script>
  import "../scripts/activity-toy-box";
</script>

<style>
  .activity-toybox {
    position: relative;
    display: block;
    margin-top: 38px;
  }

  .activity-toybox-heading {
    position: absolute;
    top: 0;
    left: 18px;
    z-index: 2;
    margin: 0;
    padding-inline: 8px;
    transform: translateY(-50%);
    background: var(--bg);
    color: var(--tx-2);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .activity-toybox-hint {
    position: absolute;
    top: 9px;
    right: 12px;
    z-index: 2;
    margin: 0;
    color: var(--tx-3);
    font-size: 12px;
    line-height: 18px;
    pointer-events: none;
  }

  .activity-toybox-hint-touch,
  .activity-toybox-hint-reduced {
    display: none;
  }

  .activity-toybox-frame {
    position: relative;
    height: 176px;
    overflow: hidden;
    border: 1px solid var(--ui-2);
    border-radius: 2px;
    background: color-mix(in srgb, var(--bg-2) 24%, transparent);
  }

  .activity-toybox-world {
    position: absolute;
    inset: 0;
  }

  .activity-toybox-body {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    opacity: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
    will-change: transform;
    transition: opacity var(--motion-normal) var(--ease-out);
  }

  .activity-toybox[data-enhanced] .activity-toybox-body {
    opacity: 0;
  }

  .activity-toybox[data-ready] .activity-toybox-body {
    opacity: 1;
  }

  .activity-toybox-body[data-dragging] {
    z-index: 3;
    cursor: grabbing;
  }

  .activity-toybox-body[data-kind="climbing"] {
    width: 86px;
    height: 60px;
    color: var(--purple);
    --activity-color: var(--purple);
    --resting-angle: 12deg;
  }

  .activity-toybox-body[data-kind="running"] {
    width: 82px;
    height: 56px;
    color: var(--magenta);
    --activity-color: var(--magenta);
    --resting-angle: -7deg;
  }

  .activity-toybox-body[data-kind="basketball"] {
    width: 58px;
    height: 54px;
    color: var(--orange);
    --activity-color: var(--orange);
    --resting-angle: -20deg;
  }

  .activity-toybox:not([data-enhanced]) .activity-toybox-body {
    top: auto;
    bottom: 12px;
    transform: translate3d(-50%, 0, 0);
  }

  .activity-toybox:not([data-enhanced]) .activity-toybox-body[data-kind="climbing"] {
    left: 20%;
  }

  .activity-toybox:not([data-enhanced]) .activity-toybox-body[data-kind="running"] {
    bottom: 20px;
    left: 50%;
  }

  .activity-toybox:not([data-enhanced]) .activity-toybox-body[data-kind="basketball"] {
    left: 80%;
  }

  .activity-toybox-glyph {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(var(--resting-angle));
    will-change: transform;
  }

  :global(.activity-toybox-doodle) {
    width: 100%;
    height: 100%;
  }

  .activity-toybox-label {
    position: absolute;
    bottom: calc(100% + 9px);
    left: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 7px;
    border: 1px solid var(--ui-2);
    border-radius: 2px;
    opacity: 0;
    transform: translate3d(-50%, 6px, 0) scale(0.94);
    transform-origin: 50% 100%;
    background: var(--bg-2);
    color: var(--tx);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    white-space: nowrap;
    pointer-events: none;
    transition:
      transform var(--motion-fast) var(--ease-out),
      opacity var(--motion-fast) var(--ease-out);
  }

  .activity-toybox-label::before {
    width: 5px;
    height: 5px;
    flex: none;
    border-radius: 50%;
    background: var(--activity-color);
    content: "";
  }

  .activity-toybox-label::after {
    position: absolute;
    bottom: -4px;
    left: 50%;
    width: 6px;
    height: 6px;
    border-right: 1px solid var(--ui-2);
    border-bottom: 1px solid var(--ui-2);
    transform: translateX(-50%) rotate(45deg);
    background: var(--bg-2);
    content: "";
  }

  .activity-toybox-body[data-label-below] .activity-toybox-label {
    top: calc(100% + 9px);
    bottom: auto;
    transform: translate3d(-50%, -6px, 0) scale(0.94);
    transform-origin: 50% 0;
  }

  .activity-toybox-body[data-label-below] .activity-toybox-label::after {
    top: -4px;
    bottom: auto;
    border: 0;
    border-top: 1px solid var(--ui-2);
    border-left: 1px solid var(--ui-2);
  }

  .activity-toybox-body[data-dragging] .activity-toybox-label {
    opacity: 1;
    transform: translate3d(-50%, 0, 0) scale(1);
    transition-duration: var(--motion-normal);
  }

  @media (hover: hover) and (pointer: fine) {
    .activity-toybox-body:hover {
      z-index: 2;
    }

    .activity-toybox-body:hover .activity-toybox-label {
      opacity: 1;
      transform: translate3d(-50%, 0, 0) scale(1);
      transition-duration: var(--motion-normal);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .activity-toybox-hint-fine {
      display: none;
    }

    .activity-toybox-hint-touch {
      display: inline;
    }
  }

  @media (max-width: 560px) {
    .activity-toybox-frame {
      height: 144px;
    }

    .activity-toybox-body[data-kind="climbing"] {
      width: 70px;
      height: 49px;
    }

    .activity-toybox-body[data-kind="running"] {
      width: 68px;
      height: 46px;
    }

    .activity-toybox-body[data-kind="basketball"] {
      width: 48px;
      height: 45px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-toybox-body {
      cursor: default;
      transition: opacity var(--motion-fast) var(--ease-out) !important;
    }

    .activity-toybox-label,
    .activity-toybox-body[data-label-below] .activity-toybox-label {
      transform: translate3d(-50%, 0, 0) scale(1);
      transition: opacity var(--motion-fast) var(--ease-out) !important;
    }

    .activity-toybox-hint-fine,
    .activity-toybox-hint-touch {
      display: none;
    }

    .activity-toybox-hint-reduced {
      display: inline;
    }
  }
</style>

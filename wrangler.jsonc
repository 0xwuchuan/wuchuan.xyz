{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wuchuan-xyz",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "wuchuan.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}

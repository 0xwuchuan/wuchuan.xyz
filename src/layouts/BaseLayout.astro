---
import { ClientRouter } from "astro:transitions";
import themeScript from "../scripts/theme.js?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  ogType = "website",
  publishedDate,
  updatedDate,
} = Astro.props;
const pageTitle = title ? `wuchuan • ${title}` : "wuchuan • home";
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#100f0f" />
    <script is:inline src={themeScript}></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="wuchuan's digital garden" href={new URL("/rss.xml", Astro.site)} />
    <link rel="preload" href="/fonts/Satoshi-Variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="wuchuan" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="0xwuchuan — software engineer, builder, and digital gardener" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">skip to content</a>
    <slot />
  </body>
</html>

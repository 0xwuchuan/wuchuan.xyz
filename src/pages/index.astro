---
import BaseLayout from "../layouts/BaseLayout.astro";
import Doodle from "../components/Doodle.astro";
import Footer from "../components/Footer.astro";
import SiteShell from "../components/SiteShell.astro";
---

<BaseLayout description="0xwuchuan is a software engineer curious about blockchain, DeFi, AI, and hard technical problems.">
  <SiteShell activePage="about">
    <main id="main-content" class="about page-pad">
      <div class="about-copy">
        <p>
          currently a software engineer at <a href="https://www.okx.com/en-sg">okx</a>.
          previously worked at ___ and others
        </p>
        <p>
          i'm curious by nature and enjoy working on hard problems. i love learning about all things tech, and lately i've been going deep into blockchain technology, defi and ai.
        </p>
        <p>
          i touch grass through, but am not limited to: travelling, climbing (plastic) rocks, voluntarily suffering through runs, playing and watching sports, and spending time with friends
        </p>
      </div>
      <Doodle name="climbing-holds" class="activity-doodle climbing-doodle" />
      <Doodle name="basketball" class="activity-doodle basketball-doodle" />
      <Doodle name="running" class="activity-doodle running-doodle" />
    </main>
    <Footer />
  </SiteShell>
</BaseLayout>
